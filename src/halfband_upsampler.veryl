import gndless_fixedpoint::Types;
import gndless_fixedpoint::FixedPointValue;
import gndless_fixedpoint::Q4_23;
import gndless_fixedpoint::Q1_17;

/// 複数channelのframe vectorを1個のMACでTDM処理する2x halfband upsampler。
///
/// sampleはQ4.23、係数はQ1.17。module境界はQ4.23で統一し、±1.0の信号を±8.0の範囲で扱う。
/// 出力もQ4.23のまま。補間によって+/-1.0を超える場合もある。
/// 入力はQ4.23上で+/-1.0以内(Q1.23相当)であることを前提とする。even phaseの係数の絶対値和は約1.346なので、
/// 出力は最大+/-1.35程度、`pair_sum`(対称tapの和)は最大+/-2.7程度になり、どちらもQ4.23(±8)の範囲に収まる。
/// この前提を外れる入力(Q4.23上で±4.0を超える両端)では`pair_sum`が27bitでwrapし、乗算前に破損するため、
/// producer側で入力が+/-1.0以内に収まることを保証すること。
/// 入力frameは`input_valid && input_ready`で受理し、処理中は`input_ready`をLowにする。
/// 出力はeven phase、odd phaseの順にchannel vectorを1回ずつ出力する。
/// `output_valid`と`output_samples`は1クロックの出力レジスタを経由する。各出力は対応する状態に入ってから
/// 1クロック後に現れ、ちょうど1クロックの間保持される。2x upsamplerのため入力frame 1つにつき
/// even/oddの2出力frameを2クロック連続のburstとして出力するので、`output_valid`は2クロック連続でHighになる。
///
/// historyはSRAM推論のためresetで初期化しない。起動直後の内容は不定であり、最初のHISTORY_LENGTH
/// frame分の出力には不定値が含まれる。ストリームが進めば即座に実データへ置き換わるため、
/// 消費側は起動過渡の値を要求しないこと。
/// historyは循環アドレス方式(書き込み位置のみが前進し、タップkは書き込み位置からk前の位置にある)で、
/// left/rightの2タップを同時に読むため同じ内容を2コピー持つ。書き込みは入力受理後に1 channelずつ行う。
/// MACはSRAMの同期読み出し(登録アドレス、1clkレイテンシ)をprefetchパイプラインで吸収し、
/// 1 pair/cycleを維持する。SRAMの書き込みと読み出しは別状態で行うためread-during-writeは発生しない。
///
/// 係数はfull tap列ではなく、halfbandの対称pair係数を実装した
/// `HalfbandCoefficientSet` packageから受け取る。MAC自体はchannelと係数pairの
/// 両方向へ時分割共有する。
///
/// COEFFICIENT_SETは係数set prototype`HalfbandCoefficientSet`を実装したpackageで、デフォルトは`Halfband103Q1_17`。
/// Tap数が少ない`Halfband39Q1_17`も用意している。tap数が少ないと周波数特性は悪化するが、MACの処理時間は短くなる。
pub module HalfbandUpsampler::<COEFFICIENT_SET: HalfbandCoefficientSet = Halfband103Q1_17> #(
    param CHANNELS: u8 = 2, /// channel数。1つのMACでTDM処理する。ステレオを想定して2をデフォルトとする。
) (
    clk           : input   clock                                           , /// system clock
    rst           : input   reset                                           , /// reset
    input_valid   : input   bbool                                           , /// input frame vector valid
    input_ready   : output  bbool                                           , /// input frame vector ready
    input_samples : modport FixedPointValue::<Q4_23>::input_port  [CHANNELS], /// Q4.23 input frame vector
    output_valid  : output  bbool                                           , /// output vector valid
    output_samples: modport FixedPointValue::<Q4_23>::output_port [CHANNELS], /// Q4.23 output frame vector
) {
    const HISTORY_LENGTH   : u32 = COEFFICIENT_SET::PAIR_COUNT * 2;
    const WORD_COUNT       : u32 = CHANNELS * HISTORY_LENGTH;
    const HISTORY_LENGTH_U8: u8  = HISTORY_LENGTH as u8;
    const PAIR_COUNT_U8    : u8  = COEFFICIENT_SET::PAIR_COUNT as u8;

    const PRODUCT_WIDTH    : u8                                                                                  = Q4_23::WIDTH
        + Q1_17::WIDTH; // 乗算器の出力幅: 入力幅+係数幅
    const ACCUMULATOR_WIDTH: u8                                                                                  = PRODUCT_WIDTH
        + $clog2(COEFFICIENT_SET::PAIR_COUNT) + 2; // 2は加算でのオーバーフローを考慮したguard bit
    type product_t         = signed logic<Q4_23::WIDTH + Q1_17::WIDTH>                                          ;
    type accumulator_t     = signed logic<Q4_23::WIDTH + Q1_17::WIDTH + $clog2(COEFFICIENT_SET::PAIR_COUNT) + 2>;
    // TODO veryl側でgeneric module instantiation時のtype/const宣言順解析が修正されたら、
    //      type宣言をconst参照(signed logic<PRODUCT_WIDTH> / signed logic<ACCUMULATOR_WIDTH>)へ戻す

    const INPUT_FRAC : u8 = Q4_23::FRACTION_BITS + Q1_17::FRACTION_BITS;
    const OUTPUT_FRAC: u8 = Q4_23::FRACTION_BITS;

    enum State {
        Idle,
        Write,
        Mac,
        OutputEven,
        OutputOdd,
    }
    import State::*;

    // historyはBSRAM推論のためresetを持たないplain配列をleft/rightの2コピー持つ。
    // 読み出しは同一always_ff内の登録アドレス+登録出力で行い、GowinのBSRAM推論に適合させる。
    // resetを持たないため初期値は不定で、最初のHISTORY_LENGTH frame分の出力に不定値が含まれる。
    // ストリームが進めば即座に実データへ置き換わる。
    var history_left    : Q4_23::Raw [WORD_COUNT];
    var history_right   : Q4_23::Raw [WORD_COUNT];
    var history_write_en: logic                  ;
    var write_addr      : u8         [CHANNELS]  ;
    var next_write_addr : u8         [CHANNELS]  ;
    var frame_samples   : Q4_23::Raw [CHANNELS]  ;
    var write_ch        : u8                     ;

    var state      : State;
    var mac_channel: u8   ;
    var mac_cycle  : u8   ;

    // MACのprefetchパイプライン。issue_pairは発行中のpairで、PAIR_COUNTと等しいときは
    // oddタップの読み出しを意味する。issue_pair_qは前サイクルに発行したpairで、係数選択に使う。
    // 読み出し2clk+積1clkのレイテンシを持ち、積算は積レジスタ(product_q)から行う。
    var issue_pair   : u8           ;
    var issue_pair_q : u8           ;
    var issue_pair_q2: u8           ;
    var accumulator  : accumulator_t;

    var read_addr_a: u8        ;
    var read_addr_b: u8        ;
    var read_data_a: Q4_23::Raw;
    var read_data_b: Q4_23::Raw;

    // Gowin合成はprocedural forでinterface配列要素を定数選択できないため、
    // generate assignでplain配列へコピーして使う。
    var input_raw : Q4_23::Raw [CHANNELS];
    var output_raw: Q4_23::Raw [CHANNELS];
    for channel in 0..CHANNELS :g_in {
        assign input_raw[channel] = input_samples[channel].raw;
    }
    for channel in 0..CHANNELS :g_out {
        assign output_samples[channel].raw = output_raw[channel];
    }

    // チャンネルごとの語オフセットは定数であり、`channel * HISTORY_LENGTH`の乗算は
    // Gowin合成でDSP(MULT12X12)へ推論される。generate展開した定数配列を動的インデックスで
    // 選択(mux)することでDSP資源を節約する。
    var channel_offset: u8 [CHANNELS];
    for channel in 0..CHANNELS :g_ch_offset {
        assign channel_offset[channel] = (channel as u8) * HISTORY_LENGTH_U8;
    }

    var even_samples: Q4_23::Raw [CHANNELS];
    var odd_samples : Q4_23::Raw [CHANNELS];

    var read_addr_a_next: u8                    ;
    var read_addr_b_next: u8                    ;
    var write_word_addr : u8                    ;
    var write_data      : Q4_23::Raw            ;
    var pair_sum        : Q4_23::Raw            ;
    var coefficient     : COEFFICIENT_SET::Value;
    var product         : product_t             ;
    var product_q       : product_t             ;
    var product_ext     : accumulator_t         ;
    var next_accumulator: accumulator_t         ;
    var even_result     : Q4_23::Raw            ;

    always_comb {
        for channel in 0..CHANNELS {
            if write_addr[channel] == HISTORY_LENGTH - 1 {
                next_write_addr[channel] = 0;
            } else {
                next_write_addr[channel] = write_addr[channel] + 1;
            }
        }

        input_ready = false;
        if state == Idle {
            input_ready = true;
        }

        write_word_addr  = channel_offset[write_ch] + write_addr[write_ch];
        write_data       = frame_samples[write_ch];
        history_write_en = state == Write;

        if mac_cycle <= PAIR_COUNT_U8 {
            issue_pair = mac_cycle;
        } else {
            issue_pair = PAIR_COUNT_U8;
        }

        // タップkは (write_addr - 1 - k) mod HISTORY_LENGTH にある。
        // port Aはleftタップ(p)、port Bはrightタップ(HISTORY_LENGTH - 1 - p)を読む。
        // rightタップの式は (write_addr + p) mod HISTORY_LENGTH に変形でき、
        // p == PAIR_COUNTでoddタップ(DELAY)と一致するため、発行最終サイクルは
        // port Bにoddタップを読ませる。
        let wa              : u8 = write_addr[mac_channel];
        let v_a             : u8 = wa + HISTORY_LENGTH_U8 - 1 - issue_pair;
        let tap_a           : u8 = if v_a >= HISTORY_LENGTH_U8 ? v_a - HISTORY_LENGTH_U8 : v_a;
        let v_b             : u8 = wa + issue_pair;
        let tap_b           : u8 = if v_b >= HISTORY_LENGTH_U8 ? v_b - HISTORY_LENGTH_U8 : v_b;
        read_addr_a_next = channel_offset[mac_channel] + tap_a;
        read_addr_b_next = channel_offset[mac_channel] + tap_b;

        pair_sum    = read_data_a + read_data_b;
        var coeff_index: u8;
        if issue_pair_q2 >= PAIR_COUNT_U8 {
            coeff_index = PAIR_COUNT_U8 - 1;
        } else {
            coeff_index = issue_pair_q2;
        }
        coefficient = COEFFICIENT_SET::VALUES[coeff_index];
        product     = pair_sum * coefficient;
        product_ext = $std::sign_extend::<product_t, accumulator_t>(product);
        // 積はレジスタに載せ、乗算を積算パスから外してFmaxを確保する
        next_accumulator = accumulator + $std::sign_extend::<product_t, accumulator_t>(product_q);
        even_result      = gndless_fixedpoint::resize::<
            ACCUMULATOR_WIDTH                               ,
            INPUT_FRAC                                      ,
            Q4_23::WIDTH                                    ,
            OUTPUT_FRAC                                     ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(next_accumulator);
    }

    always_ff {
        if_reset {
            state         = Idle;
            write_ch      = 0;
            mac_channel   = 0;
            mac_cycle     = 0;
            issue_pair_q  = 0;
            issue_pair_q2 = 0;
            product_q     = 0;
            accumulator   = 0;
            read_addr_a   = 0;
            read_addr_b   = 0;
            read_data_a   = Q4_23::ZERO;
            read_data_b   = Q4_23::ZERO;
            for channel in 0..CHANNELS {
                write_addr[channel]    = 0;
                frame_samples[channel] = Q4_23::ZERO;
                even_samples[channel]  = Q4_23::ZERO;
                odd_samples[channel]   = Q4_23::ZERO;
            }
        } else if state == Idle {
            if input_valid && input_ready {
                for channel in 0..CHANNELS {
                    frame_samples[channel] = input_raw[channel];
                }
                write_ch = 0;
                state    = Write;
            }
        } else if state == Write {
            // 受理したframeを1 channelずつ両コピーへ書き込む。
            history_left[write_word_addr]  = write_data;
            history_right[write_word_addr] = write_data;
            for channel in 0..CHANNELS {
                if channel == write_ch {
                    write_addr[channel] = next_write_addr[channel];
                }
            }
            if write_ch == CHANNELS - 1 {
                mac_channel = 0;
                mac_cycle   = 0;
                state       = Mac;
            } else {
                write_ch = write_ch + 1;
            }
        } else if state == Mac {
            // BSRAM推論: 登録アドレスから登録出力へ読み出す(発行から2clk後に入力に現れる)
            read_data_a   = history_left[read_addr_a];
            read_data_b   = history_right[read_addr_b];
            read_addr_a   = read_addr_a_next;
            read_addr_b   = read_addr_b_next;
            issue_pair_q  = issue_pair;
            issue_pair_q2 = issue_pair_q;
            product_q     = product;
            if mac_cycle <= 2 {
                // 初回2サイクルは読み出しパイプラインの無効データが届くため積算しない
                accumulator = 0;
            } else {
                accumulator = next_accumulator;
            }
            if mac_cycle == PAIR_COUNT_U8 + 2 {
                even_samples[mac_channel] = even_result;
                odd_samples[mac_channel]  = read_data_b;
                if mac_channel == CHANNELS - 1 {
                    state = OutputEven;
                } else {
                    mac_channel = mac_channel + 1;
                    mac_cycle   = 0;
                }
            } else {
                mac_cycle = mac_cycle + 1;
            }
        } else if state == OutputEven {
            state = OutputOdd;
        } else if state == OutputOdd {
            state = Idle;
        }
    }

    always_ff {
        if_reset {
            output_valid = false;
            for channel in 0..CHANNELS {
                output_raw[channel] = Q4_23::ZERO;
            }
        } else if state == OutputEven {
            output_valid = true;
            for channel in 0..CHANNELS {
                output_raw[channel] = even_samples[channel];
            }
        } else if state == OutputOdd {
            output_valid = true;
            for channel in 0..CHANNELS {
                output_raw[channel] = odd_samples[channel];
            }
        } else {
            output_valid = false;
            for channel in 0..CHANNELS {
                output_raw[channel] = Q4_23::ZERO;
            }
        }
    }
}

/// HalfbandUpsamplerのDC応答とodd位相の遅延恒等を検証
///
/// 係数setは`Halfband39Q1_17`を使い、DCゲインがちょうど1 + 2^-16になることを利用する。
/// 39 tap setの係数和は2 * sum(VALUES) = 2^17 + 2なので、DC入力Vに対するeven phase出力は
/// V + (V >> 16)に剰余なしで一致する。odd phaseは中央tapを通過した入力の遅延恒等で、
/// 入力からDELAY (PAIR_COUNT - 1) frame前の値をそのまま出力する。
/// 判定はDCフェーズをHISTORY_LENGTH (20) frame分投入した後の出力で行い、
/// 起動過渡の不定値(history初期値)は対象外とする。
#[test(test_halfband_upsampler)]
module test_halfband_upsampler {
    const PAIR_COUNT: u8  = 10;
    const DELAY     : u32 = PAIR_COUNT - 1;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid : bbool;
    var input_ready : bbool;
    var output_valid: bbool;

    inst input_samples : FixedPointValue::<Q4_23> [2];
    inst output_samples: FixedPointValue::<Q4_23> [2];

    inst dut: HalfbandUpsampler::<Halfband39Q1_17> #(
        CHANNELS: 2,
    ) (
        clk           : clk           ,
        rst           : rst           ,
        input_valid   : input_valid   ,
        input_ready   : input_ready   ,
        input_samples : input_samples ,
        output_valid  : output_valid  ,
        output_samples: output_samples,
    );

    initial {
        input_valid = false;
        for i in 0..2 {
            input_samples[i].raw = Q4_23::ZERO;
        }
        rst.assert();
        clk.next(1);

        // DCフェーズ: HISTORY_LENGTH分を含む20 frameを一定値で投入し、最後のframeのeven/oddを判定する
        for _frame in 0..20 {
            for _i in 0..100 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = Q4_23::ONE;
            input_samples[1].raw = Q4_23::NEG_ONE;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..100 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        $assert(
            output_samples[0].raw == Q4_23::ONE + (Q4_23::ONE >>> 16),
            "halfband even phase DC gain (ch0) mismatch",
        );
        $assert(
            output_samples[1].raw == Q4_23::NEG_ONE + (Q4_23::NEG_ONE >>> 16),
            "halfband even phase DC gain (ch1) mismatch",
        );
        clk.next(1);
        $assert(output_samples[0].raw == Q4_23::ONE, "halfband odd phase identity (ch0) mismatch");
        $assert(output_samples[1].raw == Q4_23::NEG_ONE, "halfband odd phase identity (ch1) mismatch");
        clk.next(1);
        $assert(!output_valid, "halfband output must be a two-cycle burst");

        // rampフェーズ: 可変入力を投入し、odd phaseがDELAY frame前の入力と一致することを確認する
        for frame in 0..10 {
            for _i in 0..100 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = (100 + frame * 10) as Q4_23::Raw;
            input_samples[1].raw = (200 + frame * 10) as Q4_23::Raw;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..100 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        $assert(
            output_samples[0].raw == 27'sd100,
            "halfband odd phase must output the input of DELAY frames before (ch0)",
        );
        $assert(
            output_samples[1].raw == 27'sd200,
            "halfband odd phase must output the input of DELAY frames before (ch1)",
        );
        $finish();
    }
}

/// 4ch構成で`Halfband103Q1_17`を使い、DC応答とodd位相の遅延恒等を検証
///
/// 103 tap setの係数和はsum(VALUES) = 2^16 - 1なので、DC入力Vに対するeven phase出力は
/// V - (V >> 16)に剰余なしで一致する。odd phaseは入力からDELAY (PAIR_COUNT - 1) frame前の
/// 値をそのまま出力する。判定はDCフェーズをHISTORY_LENGTH (52) frame分投入した後の出力で行い、
/// 起動過渡の不定値(history初期値)は対象外とする。
#[test(test_halfband_upsampler_4ch)]
module test_halfband_upsampler_4ch {
    const DELAY: u32 = 25;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid : bbool;
    var input_ready : bbool;
    var output_valid: bbool;

    inst input_samples : FixedPointValue::<Q4_23> [4];
    inst output_samples: FixedPointValue::<Q4_23> [4];

    inst dut: HalfbandUpsampler::<Halfband103Q1_17> #(
        CHANNELS: 4,
    ) (
        clk           : clk           ,
        rst           : rst           ,
        input_valid   : input_valid   ,
        input_ready   : input_ready   ,
        input_samples : input_samples ,
        output_valid  : output_valid  ,
        output_samples: output_samples,
    );

    initial {
        input_valid = false;
        for i in 0..4 {
            input_samples[i].raw = Q4_23::ZERO;
        }
        rst.assert();
        clk.next(1);

        // DCフェーズ: HISTORY_LENGTH分を含む60 frameを一定値で投入し、even/oddを判定する
        for _frame in 0..60 {
            for _i in 0..200 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = Q4_23::ONE;
            input_samples[1].raw = Q4_23::NEG_ONE;
            input_samples[2].raw = 27'sd4_194_304;
            input_samples[3].raw = -27'sd4_194_304;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..200 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        // 103 tap setのeven DC gainは 1 - 2^-16
        $assert(output_samples[0].raw == Q4_23::ONE - 27'sd128, "halfband 4ch even phase DC gain (ch0) mismatch");
        $assert(output_samples[1].raw == Q4_23::NEG_ONE + 27'sd128, "halfband 4ch even phase DC gain (ch1) mismatch");
        $assert(output_samples[2].raw == 27'sd4_194_240, "halfband 4ch even phase DC gain (ch2) mismatch");
        $assert(output_samples[3].raw == -27'sd4_194_240, "halfband 4ch even phase DC gain (ch3) mismatch");
        clk.next(1);
        $assert(output_samples[0].raw == Q4_23::ONE, "halfband 4ch odd phase identity (ch0) mismatch");
        $assert(output_samples[1].raw == Q4_23::NEG_ONE, "halfband 4ch odd phase identity (ch1) mismatch");
        $assert(output_samples[2].raw == 27'sd4_194_304, "halfband 4ch odd phase identity (ch2) mismatch");
        $assert(output_samples[3].raw == -27'sd4_194_304, "halfband 4ch odd phase identity (ch3) mismatch");
        clk.next(1);
        $assert(!output_valid, "halfband 4ch output must be a two-cycle burst");

        // rampフェーズ: 可変入力を投入し、odd phaseがDELAY frame前の入力と一致することを確認する。
        // 最後の出力(60 + 30 - 1 frame目)のoddはDELAY=25前のframe、すなわちramp 4 frame目になる。
        for frame in 0..30 {
            for _i in 0..200 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = (1000 + frame * 10) as Q4_23::Raw;
            input_samples[1].raw = (2000 + frame * 10) as Q4_23::Raw;
            input_samples[2].raw = (3000 + frame * 10) as Q4_23::Raw;
            input_samples[3].raw = (4000 + frame * 10) as Q4_23::Raw;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..200 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        $assert(
            output_samples[0].raw == 27'sd1040,
            "halfband 4ch odd phase must output the input of DELAY frames before (ch0)",
        );
        $assert(
            output_samples[1].raw == 27'sd2040,
            "halfband 4ch odd phase must output the input of DELAY frames before (ch1)",
        );
        $assert(
            output_samples[2].raw == 27'sd3040,
            "halfband 4ch odd phase must output the input of DELAY frames before (ch2)",
        );
        $assert(
            output_samples[3].raw == 27'sd4040,
            "halfband 4ch odd phase must output the input of DELAY frames before (ch3)",
        );
        $finish();
    }
}

/// 2段cascade(S1=103tap → BurstFifo → S2=39tap)のDC応答とburst伝搬を検証
///
/// DC入力Vに対するS1のeven出力は V - 2^-16 (E)、odd出力はV(遅延恒等)である。
/// S2の入力はEとVが交互に並ぶため、対称pairの和は常に E+V で一定になり、
/// S2のeven出力は round((E+V) * sum(VALUES_39) / 2^17) に一致する。
/// S2のodd出力は入力からDELAY(9) frame前の値で、EとVが交互に現れる。
/// 段間のBurstFifoはS1の2クロックburstを欠落・順序反転なくS2へ渡す。
#[test(test_halfband_upsampler_cascade)]
module test_halfband_upsampler_cascade {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid : bbool;
    var input_ready : bbool;
    var output_valid: bbool;

    inst input_samples : FixedPointValue::<Q4_23> [4];
    inst output_samples: FixedPointValue::<Q4_23> [4];

    var mid_valid: bbool;
    var mid_ready: bbool;
    var s2_valid : bbool;
    var s2_ready : bbool;
    inst mid_samples: FixedPointValue::<Q4_23> [4];
    inst s2_samples : FixedPointValue::<Q4_23> [4];

    inst s1: HalfbandUpsampler::<Halfband103Q1_17> #(
        CHANNELS: 4,
    ) (
        clk                        ,
        rst                        ,
        input_valid                ,
        input_ready                ,
        input_samples              ,
        output_valid  : mid_valid  ,
        output_samples: mid_samples,
    );

    inst mid_fifo: BurstFifo #(
        CHANNELS: 4,
    ) (
        clk                        ,
        rst                        ,
        input_valid   : mid_valid  ,
        input_ready   : mid_ready  ,
        input_samples : mid_samples,
        output_valid  : s2_valid   ,
        output_ready  : s2_ready   ,
        output_samples: s2_samples ,
    );

    inst s2: HalfbandUpsampler::<Halfband39Q1_17> #(
        CHANNELS: 4,
    ) (
        clk                       ,
        rst                       ,
        input_valid   : s2_valid  ,
        input_ready   : s2_ready  ,
        input_samples : s2_samples,
        output_valid              ,
        output_samples            ,
    );

    initial {
        input_valid = false;
        for i in 0..4 {
            input_samples[i].raw = Q4_23::ZERO;
        }
        rst.assert();
        clk.next(1);

        // DCフェーズ: S1(52) + S2(20)分を含む130 frameを一定値で投入する
        for _frame in 0..130 {
            for _i in 0..300 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = Q4_23::ONE;
            input_samples[1].raw = Q4_23::NEG_ONE;
            input_samples[2].raw = 27'sd4_194_304;
            input_samples[3].raw = -27'sd4_194_304;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..300 {
            if output_valid {
                break;
            }
            clk.next(1);
        }

        // S2のeven出力は round((E+V) * 65537 / 2^17)。
        // ch0: V=2^23 → 8_388_672、ch1: -8_388_672、ch2: 4_194_336、ch3: -4_194_336
        $assert(output_samples[0].raw == 27'sd8_388_672, "cascade even output (ch0) must be V + 64");
        $assert(output_samples[1].raw == -27'sd8_388_672, "cascade even output (ch1) must be -(V + 64)");
        $assert(output_samples[2].raw == 27'sd4_194_336, "cascade even output (ch2) must be V + 32");
        $assert(output_samples[3].raw == -27'sd4_194_336, "cascade even output (ch3) must be -(V + 32)");

        // S2のodd出力はE(= V - V>>16)とV(遅延恒等)が交互に現れる
        var seen_odd_v: logic;
        var seen_odd_e: logic;
        seen_odd_v = 1'b0;
        seen_odd_e = 1'b0;
        for _burst in 0..4 {
            for _i in 0..200 {
                if output_valid {
                    break;
                }
                clk.next(1);
            }
            clk.next(1);
            $assert(output_valid, "cascade output must be a two-cycle burst");
            let odd0: logic<27> = output_samples[0].raw;
            if odd0 == Q4_23::ONE {
                seen_odd_v = 1'b1;
            } else if odd0 == Q4_23::ONE - 27'sd128 {
                seen_odd_e = 1'b1;
            }
            $assert(
                odd0 == Q4_23::ONE || odd0 == Q4_23::ONE - 27'sd128,
                "cascade odd output (ch0) must be V or V - 2^-16",
            );
            let odd1: logic<27> = output_samples[1].raw;
            $assert(
                odd1 == Q4_23::NEG_ONE || odd1 == Q4_23::NEG_ONE + 27'sd128,
                "cascade odd output (ch1) must be -V or -(V - 2^-16)",
            );
            let odd2: logic<27> = output_samples[2].raw;
            $assert(
                odd2 == 27'sd4_194_304 || odd2 == 27'sd4_194_240,
                "cascade odd output (ch2) must be V or V - 2^-16",
            );
            let odd3: logic<27> = output_samples[3].raw;
            $assert(
                odd3 == -27'sd4_194_304 || odd3 == -27'sd4_194_240,
                "cascade odd output (ch3) must be -V or -(V - 2^-16)",
            );
            clk.next(1);
            $assert(!output_valid, "cascade output must be a two-cycle burst");
            clk.next(1);
        }
        $assert(seen_odd_v && seen_odd_e, "cascade odd outputs must alternate between V and V - 2^-16");
        $finish();
    }
}

/// 2クロック連続のburst入力をfront BurstFifoが吸収し、2段cascadeへ順序を保って流すことを検証
///
/// S/MUX2相当のA/B burst(2 frame連続)をfront FIFOへ投入し、ready違反(取りこぼし)がなく
/// DC値がcascadeを通して正しく出力されることを確認する。
#[test(test_halfband_upsampler_burst_input)]
module test_halfband_upsampler_burst_input {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid : bbool;
    var input_ready : bbool;
    var output_valid: bbool;
    var ready_error : bbool;

    inst input_samples : FixedPointValue::<Q4_23> [4];
    inst output_samples: FixedPointValue::<Q4_23> [4];

    var front_valid: bbool;
    var s1_ready   : bbool;
    inst front_samples: FixedPointValue::<Q4_23> [4];

    var mid_valid: bbool;
    var mid_ready: bbool;
    var s2_valid : bbool;
    var s2_ready : bbool;
    inst mid_samples: FixedPointValue::<Q4_23> [4];
    inst s2_samples : FixedPointValue::<Q4_23> [4];

    inst front_fifo: BurstFifo #(
        CHANNELS: 4,
    ) (
        clk                          ,
        rst                          ,
        input_valid                  ,
        input_ready                  ,
        input_samples                ,
        output_valid  : front_valid  ,
        output_ready  : s1_ready     ,
        output_samples: front_samples,
    );

    inst s1: HalfbandUpsampler::<Halfband103Q1_17> #(
        CHANNELS: 4,
    ) (
        clk                          ,
        rst                          ,
        input_valid   : front_valid  ,
        input_ready   : s1_ready     ,
        input_samples : front_samples,
        output_valid  : mid_valid    ,
        output_samples: mid_samples  ,
    );

    inst mid_fifo: BurstFifo #(
        CHANNELS: 4,
    ) (
        clk                        ,
        rst                        ,
        input_valid   : mid_valid  ,
        input_ready   : mid_ready  ,
        input_samples : mid_samples,
        output_valid  : s2_valid   ,
        output_ready  : s2_ready   ,
        output_samples: s2_samples ,
    );

    inst s2: HalfbandUpsampler::<Halfband39Q1_17> #(
        CHANNELS: 4,
    ) (
        clk                       ,
        rst                       ,
        input_valid   : s2_valid  ,
        input_ready   : s2_ready  ,
        input_samples : s2_samples,
        output_valid              ,
        output_samples            ,
    );

    always_ff (clk, rst) {
        if_reset {
            ready_error = false;
        } else if input_valid && !input_ready {
            ready_error = true;
        }
    }

    initial {
        input_valid = false;
        for i in 0..4 {
            input_samples[i].raw = Q4_23::ZERO;
        }
        rst.assert();
        clk.next(1);

        // A/B burst: front FIFOが空になるのを待ってから2 frame連続で投入する
        for _burst in 0..90 {
            for _i in 0..400 {
                if !front_valid {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = Q4_23::ONE;
            input_samples[1].raw = Q4_23::NEG_ONE;
            input_samples[2].raw = 27'sd4_194_304;
            input_samples[3].raw = -27'sd4_194_304;
            input_valid          = true;
            clk.next(1);
            input_valid = true;
            clk.next(1);
            input_valid = false;
        }
        clk.next(64);
        $assert(!ready_error, "burst input must never be dropped by the front fifo");

        for _i in 0..300 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        $assert(output_samples[0].raw == 27'sd8_388_672, "burst input cascade even output (ch0) must be V + 64");
        $assert(output_samples[1].raw == -27'sd8_388_672, "burst input cascade even output (ch1) must be -(V + 64)");
        $assert(output_samples[2].raw == 27'sd4_194_336, "burst input cascade even output (ch2) must be V + 32");
        $assert(output_samples[3].raw == -27'sd4_194_336, "burst input cascade even output (ch3) must be -(V + 32)");
        $finish();
    }
}
