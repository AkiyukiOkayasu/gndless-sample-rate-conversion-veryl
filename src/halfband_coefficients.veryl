/// 2x halfband補間器の対称係数set。
///
/// `VALUES`はfull FIR tap列ではなく、1個のMACで処理する対称pair係数だけを持つ。
/// 要素のFormatはgndless_fixedpoint::Q1_17::Rawである。
pub proto package HalfbandCoefficientSet {
    /// ユニークな非ゼロ係数のpair数
    /// 係数は対称であり、非ゼロ係数は奇数番目にしか現れないため、pair数はtap数の半分以下になる。そのためu8で十分である
    const PAIR_COUNT: u8;
    type Value     ;
    type Values    ;
    const VALUES    : Values;
}

/// 103 tap halfband用のQ1.17係数set。
///
/// 係数は`tools/design_halfband_coefficients.py`で設計・量子化する。
/// 全係数の絶対値は1.0未満 (最大の最内側pairで約0.636) なので、Q1.17 (範囲[-1.0, +1.0)) に収まる。
/// Q2.16より小数部が1bit多く、係数量子化誤差が半分になる。
pub package Halfband103Q1_17 for HalfbandCoefficientSet {
    const PAIR_COUNT: u8                                          = 26;
    type Value      = gndless_fixedpoint::Q1_17::Raw             ;
    type Values     = Value                          [PAIR_COUNT];

    const VALUES: Values = '{
        -18'sd4, 18'sd12, -18'sd24, 18'sd43, -18'sd71, 18'sd111, -18'sd165, 18'sd237, -18'sd330, 18'sd450, -18'sd602,
        18'sd790, -18'sd1022, 18'sd1307, -18'sd1654, 18'sd2076, -18'sd2593, 18'sd3228, -18'sd4023, 18'sd5038,
        -18'sd6383, 18'sd8263, -18'sd11121, 18'sd16109, -18'sd27463, 18'sd83326,
    };
}

/// 39 tap halfband用のQ1.17係数set。
///
/// 係数は`tools/design_halfband_coefficients.py`で設計・量子化する。
/// 全係数の絶対値は1.0未満 (最大の最内側pairで約0.630) なので、Q1.17 (範囲[-1.0, +1.0)) に収まる。
pub package Halfband39Q1_17 for HalfbandCoefficientSet {
    const PAIR_COUNT: u8                                          = 10;
    type Value      = gndless_fixedpoint::Q1_17::Raw             ;
    type Values     = Value                          [PAIR_COUNT];

    const VALUES: Values = '{
        -18'sd12, 18'sd97, -18'sd345, 18'sd902, -18'sd1977, 18'sd3878, -18'sd7122, 18'sd12888, -18'sd25367, 18'sd82595,
    };
}
