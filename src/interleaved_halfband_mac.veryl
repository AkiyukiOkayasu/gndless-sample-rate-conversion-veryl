/// 8ch共有halfband MACのmemory port疎通用skeleton。
///
/// 初回の入力受理時に、channel 0 / address 0 / tag 1 / current epochでwriteと2本のreadを1回だけ発行する。
/// halfband演算本体とschedulerは後続実装で追加する。
pub module InterleavedHalfbandMac::<FORMAT: gndless_fixedpoint::SignedFixedPointFormat = gndless_fixedpoint::Q2_23> #(
    param CHANNELS     : u32 = 8 ,
    param HISTORY_WORDS: u32 = 52,
    param ADDRESS_WIDTH: u32 = 9 ,
    param TAG_WIDTH    : u32 = 6 ,
    param EPOCH_WIDTH  : u32 = 8 ,
) (
    clk                 : input   clock                                                                       ,
    rst                 : input   reset                                                                       ,
    reset_enter         : input   bbool                                                                       ,
    input_valid         : input   bbool                                                                       ,
    input_ready         : output  bbool                                                                       ,
    input_channel       : input   logic                                                     <$clog2(CHANNELS)>,
    input_sample        : modport gndless_fixedpoint::FixedPointValue::<FORMAT>::input_port                   ,
    mem_write_valid     : output  bbool                                                                       ,
    mem_write_address   : output  logic                                                     <ADDRESS_WIDTH>   ,
    mem_write_sample    : modport gndless_fixedpoint::FixedPointValue::<FORMAT>::output_port                  ,
    mem_read0_valid     : output  bbool                                                                       ,
    mem_read0_address   : output  logic                                                     <ADDRESS_WIDTH>   ,
    mem_read0_tag       : output  logic                                                     <TAG_WIDTH>       ,
    mem_read0_epoch     : output  logic                                                     <EPOCH_WIDTH>     ,
    mem_read1_valid     : output  bbool                                                                       ,
    mem_read1_address   : output  logic                                                     <ADDRESS_WIDTH>   ,
    mem_read1_tag       : output  logic                                                     <TAG_WIDTH>       ,
    mem_read1_epoch     : output  logic                                                     <EPOCH_WIDTH>     ,
    mem_response0_valid : input   bbool                                                                       ,
    mem_response0_sample: modport gndless_fixedpoint::FixedPointValue::<FORMAT>::input_port                   ,
    mem_response0_tag   : input   logic                                                     <TAG_WIDTH>       ,
    mem_response0_epoch : input   logic                                                     <EPOCH_WIDTH>     ,
    mem_response1_valid : input   bbool                                                                       ,
    mem_response1_sample: modport gndless_fixedpoint::FixedPointValue::<FORMAT>::input_port                   ,
    mem_response1_tag   : input   logic                                                     <TAG_WIDTH>       ,
    mem_response1_epoch : input   logic                                                     <EPOCH_WIDTH>     ,
    output_valid        : output  bbool                                                                       ,
    output_sample       : modport gndless_fixedpoint::FixedPointValue::<FORMAT>::output_port                  ,
    output_channel      : output  logic                                                     <$clog2(CHANNELS)>,
    current_epoch       : output  logic                                                     <EPOCH_WIDTH>     ,
) {
    var issued: bbool             ;
    var epoch : logic<EPOCH_WIDTH>;

    assign input_ready       = !issued;
    assign current_epoch     = epoch;
    assign output_valid      = false;
    assign output_channel    = input_channel;
    assign output_sample.raw = FORMAT::ZERO;

    always_ff {
        if_reset {
            issued               = false;
            epoch                = 0;
            mem_write_valid      = false;
            mem_write_address    = 0;
            mem_write_sample.raw = FORMAT::ZERO;
            mem_read0_valid      = false;
            mem_read0_address    = 0;
            mem_read0_tag        = 0;
            mem_read0_epoch      = 0;
            mem_read1_valid      = false;
            mem_read1_address    = 0;
            mem_read1_tag        = 0;
            mem_read1_epoch      = 0;
        } else {
            mem_write_valid = false;
            mem_read0_valid = false;
            mem_read1_valid = false;

            if reset_enter {
                epoch  = epoch + 1;
                issued = false;
            } else if input_valid && input_ready {
                issued               = true;
                mem_write_valid      = true;
                mem_write_address    = 0;
                mem_write_sample.raw = input_sample.raw;
                mem_read0_valid      = true;
                mem_read0_address    = 0;
                mem_read0_tag        = 6'd1;
                mem_read0_epoch      = epoch;
                mem_read1_valid      = true;
                mem_read1_address    = 0;
                mem_read1_tag        = 6'd1;
                mem_read1_epoch      = epoch;
            }
        }
    }
}

#[test(test_interleaved_halfband_mac_smoke)]
module test_interleaved_halfband_mac_smoke {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var reset_enter  : bbool   ;
    var input_valid  : bbool   ;
    var input_ready  : bbool   ;
    var input_channel: logic<3>;
    inst input_sample: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q2_23>;
    var mem_write_valid  : bbool   ;
    var mem_write_address: logic<9>;
    inst mem_write_sample: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q2_23>;
    var mem_read0_valid    : bbool   ;
    var mem_read0_address  : logic<9>;
    var mem_read0_tag      : logic<6>;
    var mem_read0_epoch    : logic<8>;
    var mem_read1_valid    : bbool   ;
    var mem_read1_address  : logic<9>;
    var mem_read1_tag      : logic<6>;
    var mem_read1_epoch    : logic<8>;
    var mem_response0_valid: bbool   ;
    inst mem_response0_sample: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q2_23>;
    var mem_response0_tag  : logic<6>;
    var mem_response0_epoch: logic<8>;
    var mem_response1_valid: bbool   ;
    inst mem_response1_sample: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q2_23>;
    var mem_response1_tag  : logic<6>;
    var mem_response1_epoch: logic<8>;
    var output_valid       : bbool   ;
    inst output_sample: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q2_23>;
    var output_channel: logic<3>;
    var current_epoch : logic<8>;

    inst dut: InterleavedHalfbandMac (
        clk                   ,
        rst                   ,
        reset_enter           ,
        input_valid           ,
        input_ready           ,
        input_channel         ,
        input_sample          ,
        mem_write_valid       ,
        mem_write_address     ,
        mem_write_sample      ,
        mem_read0_valid       ,
        mem_read0_address     ,
        mem_read0_tag         ,
        mem_read0_epoch       ,
        mem_read1_valid       ,
        mem_read1_address     ,
        mem_read1_tag         ,
        mem_read1_epoch       ,
        mem_response0_valid   ,
        mem_response0_sample  ,
        mem_response0_tag     ,
        mem_response0_epoch   ,
        mem_response1_valid   ,
        mem_response1_sample  ,
        mem_response1_tag     ,
        mem_response1_epoch   ,
        output_valid          ,
        output_sample         ,
        output_channel        ,
        current_epoch         ,
    );

    initial {
        reset_enter              = false;
        input_valid              = false;
        input_channel            = 3'd5;
        input_sample.raw         = -25'sd12345;
        mem_response0_valid      = false;
        mem_response0_sample.raw = 25'sd0;
        mem_response0_tag        = 0;
        mem_response0_epoch      = 0;
        mem_response1_valid      = false;
        mem_response1_sample.raw = 25'sd0;
        mem_response1_tag        = 0;
        mem_response1_epoch      = 0;
        rst.assert();

        reset_enter = true;
        clk.next(1);
        reset_enter = false;
        $assert(current_epoch == 8'd1, "reset_enter must advance epoch once");

        input_valid = true;
        clk.next(1);
        input_valid = false;

        $assert(mem_write_valid, "first accepted input must issue a write");
        $assert(mem_write_address == 9'd0, "skeleton write address must be zero");
        $assert(mem_write_sample.raw == -25'sd12345, "write sample must preserve signed Q2.23 raw value");
        $assert(mem_read0_valid && mem_read1_valid, "first accepted input must issue both reads");
        $assert(mem_read0_address == 9'd0 && mem_read1_address == 9'd0, "skeleton read address must be zero");
        $assert(mem_read0_tag == 6'd1 && mem_read1_tag == 6'd1, "read tags must be one");
        $assert(mem_read0_epoch == 8'd1 && mem_read1_epoch == 8'd1, "read epochs must match current epoch");
        $assert(!input_ready, "skeleton must accept only one input before reset_enter");
        $assert(!output_valid, "skeleton must not claim computed output");
        $finish();
    }
}
