import gndless_fixedpoint::Types::{RoundingMode, OverflowMode};

/// 複数channelのframe vectorを1個のMACでTDM処理する2x halfband upsampler。
///
/// sampleはQ3.24、係数はQ1.17。24bit PCM想定だが、DSPは27bitを想定しているためguard bitなども含めてQ3.24とする。
/// 出力はQ3.24のまま。補間によって+/-1.0を超える場合もある。
/// 入力はQ3.24上で+/-1.0以内(Q1.23相当)であることを前提とする。even phaseの係数の絶対値和は約1.346なので、
/// 出力は最大+/-1.35程度、`pair_sum`(対称tapの和)は最大+/-2.7程度になり、どちらもQ3.24(±4)の範囲に収まる。
/// この前提を外れる入力(Q3.24フルレンジ±4)では`pair_sum`が27bitでwrapし、乗算前に破損するため、
/// producer側で入力が+/-1.0以内に収まることを保証すること。
/// 入力frameは`input_valid && input_ready`で受理し、処理中は`input_ready`をLowにする。
/// 出力はeven phase、odd phaseの順にchannel vectorを1回ずつ出力する。
/// `output_valid`と`output_samples`は1クロックの出力レジスタを経由する。各出力は対応する状態に入ってから
/// 1クロック後に現れ、ちょうど1クロックの間保持される。2x upsamplerのため入力frame 1つにつき
/// even/oddの2出力frameを2クロック連続のburstとして出力するので、`output_valid`は2クロック連続でHighになる。
///
/// 係数はfull tap列ではなく、halfbandの対称pair係数を実装した
/// `HalfbandCoefficientSet` packageから受け取る。MAC自体はchannelと係数pairの
/// 両方向へ時分割共有する。
///
/// COEFFICIENT_SETは係数set prototype`HalfbandCoefficientSet`を実装したpackageで、デフォルトは`Halfband103Q1_17`。
/// Tap数が少ない`Halfband39Q1_17`も用意している。tap数が少ないと周波数特性は悪化するが、MACの処理時間は短くなる。
pub module HalfbandUpsampler::<COEFFICIENT_SET: HalfbandCoefficientSet = Halfband103Q1_17> #(
    param CHANNELS: u8 = 2, /// channel数。1つのMACでTDM処理する。ステレオを想定して2をデフォルトとする。
) (
    clk           : input   clock                                                                                   , /// system clock
    rst           : input   reset                                                                                   , /// reset
    input_valid   : input   bbool                                                                                   , /// input frame vector valid
    input_ready   : output  bbool                                                                                   , /// input frame vector ready
    input_samples : modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q3_24>::input_port  [CHANNELS], /// Q3.24 input frame vector
    output_valid  : output  bbool                                                                                   , /// output vector valid
    output_samples: modport gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q3_24>::output_port [CHANNELS], /// Q3.24 output frame vector
) {
    const HISTORY_LENGTH: u32 = COEFFICIENT_SET::PAIR_COUNT * 2;
    const DELAY         : u32 = COEFFICIENT_SET::PAIR_COUNT - 1;

    const PRODUCT_WIDTH    : u8                                                                                = gndless_fixedpoint::Q3_24::WIDTH
        + gndless_fixedpoint::Q1_17::WIDTH; // 乗算器の出力幅: 入力幅+係数幅
    const ACCUMULATOR_WIDTH: u8                                                                                = PRODUCT_WIDTH
        + $clog2(COEFFICIENT_SET::PAIR_COUNT) + 2; // 2は加算でのオーバーフローを考慮したguard bit
    type product_t         = signed logic<gndless_fixedpoint::Q3_24::WIDTH + gndless_fixedpoint::Q1_17::WIDTH>;
    type accumulator_t     = signed logic<gndless_fixedpoint::Q3_24::WIDTH + gndless_fixedpoint::Q1_17::WIDTH
        + $clog2(COEFFICIENT_SET::PAIR_COUNT) + 2>;

    const INPUT_FRAC : u8 = gndless_fixedpoint::Q3_24::FRACTION_BITS + gndless_fixedpoint::Q1_17::FRACTION_BITS;
    const OUTPUT_FRAC: u8 = gndless_fixedpoint::Q3_24::FRACTION_BITS;

    enum State {
        Idle,
        Mac,
        OutputEven,
        OutputOdd,
    }
    import State::*;

    var state       : State                                                    ;
    var history     : gndless_fixedpoint::Q3_24::Raw [CHANNELS, HISTORY_LENGTH];
    var next_history: gndless_fixedpoint::Q3_24::Raw [CHANNELS, HISTORY_LENGTH];
    var even_samples: gndless_fixedpoint::Q3_24::Raw [CHANNELS]                ;
    var odd_samples : gndless_fixedpoint::Q3_24::Raw [CHANNELS]                ;

    var channel_index: u8           ;
    var pair_index   : u8           ;
    var accumulator  : accumulator_t;

    var left    : gndless_fixedpoint::Q3_24::Raw;
    var right   : gndless_fixedpoint::Q3_24::Raw;
    var pair_sum: gndless_fixedpoint::Q3_24::Raw;

    var coefficient: COEFFICIENT_SET::Value;

    var product         : product_t    ;
    var product_ext     : accumulator_t;
    var next_accumulator: accumulator_t;

    var even_result: gndless_fixedpoint::Q3_24::Raw;
    var odd_result : gndless_fixedpoint::Q3_24::Raw;

    always_comb {
        // historyのシフトは2D配列のread-modify-writeになりsimulatorがelaborateできないため、
        // combでnext_historyを計算し、ffの受理時コピーのみで更新する。
        for channel in 0..CHANNELS {
            next_history[channel][0] = input_samples[channel].raw;
            for tap in 1..HISTORY_LENGTH {
                next_history[channel][tap] = history[channel][tap - 1];
            }
        }

        input_ready = false;
        if state == Idle {
            input_ready = true;
        }

        left             = history[channel_index][pair_index];
        right            = history[channel_index][HISTORY_LENGTH - 1 - pair_index];
        pair_sum         = left + right;
        coefficient      = COEFFICIENT_SET::VALUES[pair_index];
        product          = pair_sum * coefficient;
        product_ext      = $std::sign_extend::<product_t, accumulator_t>(product);
        next_accumulator = accumulator + product_ext;
        even_result      = gndless_fixedpoint::resize::<
            ACCUMULATOR_WIDTH                        ,
            INPUT_FRAC                               ,
            gndless_fixedpoint::Q3_24::WIDTH         ,
            OUTPUT_FRAC                              ,
            RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            OverflowMode::SATURATE                   ,
        >(next_accumulator);
        odd_result       = history[channel_index][DELAY];
    }

    always_ff {
        if_reset {
            state         = Idle;
            channel_index = 0;
            pair_index    = 0;
            accumulator   = 0;
            for channel in 0..CHANNELS {
                even_samples[channel] = gndless_fixedpoint::Q3_24::ZERO;
                odd_samples[channel]  = gndless_fixedpoint::Q3_24::ZERO;
                for tap in 0..HISTORY_LENGTH {
                    history[channel][tap] = gndless_fixedpoint::Q3_24::ZERO;
                }
            }
        } else if state == Idle {
            if input_valid && input_ready {
                for channel in 0..CHANNELS {
                    for tap in 0..HISTORY_LENGTH {
                        history[channel][tap] = next_history[channel][tap];
                    }
                }
                channel_index = 0;
                pair_index    = 0;
                accumulator   = 0;
                state         = Mac;
            }
        } else if state == Mac {
            if pair_index == COEFFICIENT_SET::PAIR_COUNT - 1 {
                even_samples[channel_index] = even_result;
                odd_samples[channel_index]  = odd_result;
                if channel_index == CHANNELS - 1 {
                    state = OutputEven;
                } else {
                    channel_index += 1;
                    pair_index    =  0;
                    accumulator   =  0;
                }
            } else {
                pair_index  += 1;
                accumulator =  next_accumulator;
            }
        } else if state == OutputEven {
            state = OutputOdd;
        } else if state == OutputOdd {
            state = Idle;
        }
    }

    always_ff {
        if_reset {
            output_valid = false;
            for channel in 0..CHANNELS {
                output_samples[channel].raw = gndless_fixedpoint::Q3_24::ZERO;
            }
        } else if state == OutputEven {
            output_valid = true;
            for channel in 0..CHANNELS {
                output_samples[channel].raw = even_samples[channel];
            }
        } else if state == OutputOdd {
            output_valid = true;
            for channel in 0..CHANNELS {
                output_samples[channel].raw = odd_samples[channel];
            }
        } else {
            // output_samplesの0クリアはデバッグ時の波形の分かりやすさのためのもので、動作上は必須ではない。
            // validがLowのときのoutput_samplesはdon't careなので、保持しても構わない。
            output_valid = false;
            for channel in 0..CHANNELS {
                output_samples[channel].raw = gndless_fixedpoint::Q3_24::ZERO;
            }
        }
    }
}

/// HalfbandUpsamplerのDC応答とodd位相の遅延恒等を検証
///
/// 係数setは`Halfband39Q1_17`を使い、DCゲインがちょうど1 + 2^-16になることを利用する。
/// 39 tap setの係数和は2 * sum(VALUES) = 2^17 + 2なので、DC入力Vに対するeven phase出力は
/// V + (V >> 16)に剰余なしで一致する。odd phaseは中央tapを通過した入力の遅延恒等で、
/// 入力からDELAY (PAIR_COUNT - 1) frame前の値をそのまま出力する。
#[test(test_halfband_upsampler)]
module test_halfband_upsampler {
    const PAIR_COUNT: u8  = 10;
    const DELAY     : u32 = PAIR_COUNT - 1;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid : bbool;
    var input_ready : bbool;
    var output_valid: bbool;

    inst input_samples : gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q3_24> [2];
    inst output_samples: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q3_24> [2];

    inst dut: HalfbandUpsampler::<Halfband39Q1_17> #(
        CHANNELS: 2,
    ) (
        clk           : clk           ,
        rst           : rst           ,
        input_valid   : input_valid   ,
        input_ready   : input_ready   ,
        input_samples : input_samples ,
        output_valid  : output_valid  ,
        output_samples: output_samples,
    );

    initial {
        input_valid = false;
        for i in 0..2 {
            input_samples[i].raw = gndless_fixedpoint::Q3_24::ZERO;
        }
        rst.assert();
        clk.next(1);

        // DCフェーズ: 20 frame分を一定値で投入し、最後のframeのeven/oddを判定する
        for _frame in 0..20 {
            for _i in 0..100 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = gndless_fixedpoint::Q3_24::ONE;
            input_samples[1].raw = gndless_fixedpoint::Q3_24::NEG_ONE;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..100 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        $assert(
            output_samples[0].raw == gndless_fixedpoint::Q3_24::ONE + (gndless_fixedpoint::Q3_24::ONE >>> 16),
            "halfband even phase DC gain (ch0) mismatch",
        );
        $assert(
            output_samples[1].raw == gndless_fixedpoint::Q3_24::NEG_ONE + (gndless_fixedpoint::Q3_24::NEG_ONE >>> 16),
            "halfband even phase DC gain (ch1) mismatch",
        );
        clk.next(1);
        $assert(output_samples[0].raw == gndless_fixedpoint::Q3_24::ONE, "halfband odd phase identity (ch0) mismatch");
        $assert(
            output_samples[1].raw == gndless_fixedpoint::Q3_24::NEG_ONE,
            "halfband odd phase identity (ch1) mismatch",
        );
        clk.next(1);
        $assert(!output_valid, "halfband output must be a two-cycle burst");

        // rampフェーズ: 可変入力を投入し、odd phaseがDELAY frame前の入力と一致することを確認する
        for frame in 0..10 {
            for _i in 0..100 {
                if input_ready {
                    break;
                }
                clk.next(1);
            }
            input_samples[0].raw = (100 + frame * 10) as gndless_fixedpoint::Q3_24::Raw;
            input_samples[1].raw = (200 + frame * 10) as gndless_fixedpoint::Q3_24::Raw;
            input_valid          = true;
            clk.next(1);
            input_valid = false;
        }
        for _i in 0..100 {
            if output_valid {
                break;
            }
            clk.next(1);
        }
        clk.next(1);
        $assert(
            output_samples[0].raw == 27'sd100,
            "halfband odd phase must output the input of DELAY frames before (ch0)",
        );
        $assert(
            output_samples[1].raw == 27'sd200,
            "halfband odd phase must output the input of DELAY frames before (ch1)",
        );
        $finish();
    }
}
