import gndless_fixedpoint::Types::{RoundingMode, OverflowMode};

/// BSRAM推論可能な入力FIFO。
///
/// `$std::fifo`のRAMは非同期読み出し(BUFFER_OUT=0)のためGowin合成でBSRAMへ推論されず、
/// 段数の大きいFIFOはFF/LUTを大量に消費する。ここでは「登録アドレス→登録出力」の
/// 読み出しパターン(HalfbandUpsamplerのhistory配列と同一)でRAMを実装し、BSRAM推論に適合させる。
/// 外部から見たタイミングは`$std::fifo`(DATA_FF_OUT=1)と同一で、`q`は常に現在の先頭wordを
/// 示し、`pop`でそのwordを消費して次のwordが1クロック後に現れる。
#[allow(missing_reset_statement)]
module AsrcInputFifo #(
    param SAMPLE_WIDTH: u32 = 24, /// サンプルの符号付きビット幅
    param DEPTH       : u32 = 32, /// FIFOの深さ
) (
    clk  : input  clock                          , /// システムクロック
    rst  : input  reset                          , /// リセット
    push : input  logic                          , /// 書き込み要求
    data : input  signed logic<SAMPLE_WIDTH>     , /// 書き込みデータ
    pop  : input  logic                          , /// 読み出し要求
    empty: output logic                          , /// 空
    full : output logic                          , /// 満杯
    level: output logic       <$clog2(DEPTH + 1)>, /// ワード数
    q    : output signed logic<SAMPLE_WIDTH>     , /// 先頭word
) {
    const PTR_WIDTH  : u32 = $clog2(DEPTH);
    const LEVEL_WIDTH: u32 = $clog2(DEPTH + 1);

    var ram       : signed logic<SAMPLE_WIDTH> [DEPTH];
    var write_ptr : logic       <PTR_WIDTH>           ;
    var read_ptr  : logic       <PTR_WIDTH>           ;
    var read_addr : logic       <PTR_WIDTH>           ;
    var read_data : signed logic<SAMPLE_WIDTH>        ;
    var count     : logic       <LEVEL_WIDTH>         ;
    var next_count: logic       <LEVEL_WIDTH>         ;

    always_comb {
        // push/pop同時はカウント不変。
        if push && !pop {
            if count != DEPTH {
                next_count = count + 1;
            } else {
                next_count = count;
            }
        } else if pop && !push {
            if count != 0 {
                next_count = count - 1;
            } else {
                next_count = count;
            }
        } else {
            next_count = count;
        }
    }

    always_ff {
        if_reset {
            write_ptr = 0;
            read_ptr  = 0;
            read_addr = 0;
            read_data = 0;
            count     = 0;
        } else {
            if push && count != DEPTH {
                ram[write_ptr] = data;
                if write_ptr == DEPTH - 1 {
                    write_ptr = 0;
                } else {
                    write_ptr = write_ptr + 1;
                }
            }
            // 先頭を常時プリフェッチする。read_addrを無条件に登録してから読み出す構造は
            // HalfbandUpsamplerのBSRAM推論パターンと同一で、read_dataは登録アドレスの
            // 1クロック後に現れる。popサイクルではpop前の先頭wordが読める。
            read_addr = read_ptr;
            read_data = ram[read_addr];
            if pop && count != 0 {
                if read_ptr == DEPTH - 1 {
                    read_ptr = 0;
                } else {
                    read_ptr = read_ptr + 1;
                }
            }
            count = next_count;
        }
    }

    assign empty = count == 0;
    assign full  = count == DEPTH;
    assign level = count;
    assign q     = read_data;
}

/// FIFOから入力窓を補充しながら、50MHzの全クロックで線形補間値を出力するASRC
///
/// 入力はシステムクロックと非同期(非ロック)の外部クロック由来で、レートは`PhaseIncrementEstimator`と`FractionalPhaseAccumulator`が計測・追従する。
/// `phase`と`advance`は`gndless_nco::FractionalPhaseAccumulator`から受け取る。
/// `phase`が現在の入力サンプルから次の入力サンプルへ進む割合を表し、`advance`が次のクロックで窓を1サンプル進めることを表す。
/// 起動時に2サンプルの補間窓と、`STARTUP_LEVEL`以上の未消費FIFOが揃うまでは`output_active`をfalseにして0を出力する。burst入力ではこの値を大きくして、出力開始前にFIFOへ余裕を持たせる。
/// 動作開始後は、入力不足を`underflow`へstickyに記録しながら出力を止めない。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'input_valid',   wave: '0111110........' },
///     { name: 'input_ready',   wave: '1..............' },
///     { name: 'input_level',   wave: '23456........0.', data: ['0', '1', '2', 'startup', 'buffered', 'empty'] },
///     { name: 'window primed', wave: '0....1.........' },
///     { name: 'output_active', wave: '0....1.........' },
///     { name: 'phase',         wave: 'x....345.......', data: ['P0', 'P1', 'P2'] },
///     { name: 'advance',       wave: '0......10..10..' },
///     { name: 'underflow',     wave: '0..........1...' }
///   ],
///   head: { text: 'Startup, continuous output, and sticky underflow' }
/// }
/// ```
module LinearAsrcCore #(
    param SAMPLE_WIDTH : u32 = 24, /// 入出力サンプルの符号付きビット幅
    param PHASE_WIDTH  : u32 = 32, /// 位相入力のビット幅
    param INPUT_DEPTH  : u32 = 8 , /// 入力FIFOの深さ
    param STARTUP_LEVEL: u32 = 1 , /// 出力開始に必要な未消費FIFOワード数
) (
    clk          : input  clock                                , /// システムクロック
    rst          : input  reset                                , /// リセット
    input_valid  : input  bbool                                , /// 入力サンプル有効
    input_ready  : output bbool                                , /// 入力受理可能
    input_sample : input  signed logic<SAMPLE_WIDTH>           , /// 入力サンプル
    input_level  : output logic       <$clog2(INPUT_DEPTH + 1)>, /// 入力FIFOのワード数
    phase        : input  logic       <PHASE_WIDTH>            , /// 補間位相
    advance      : input  bbool                                , /// 次の入力サンプルへ窓を進める要求
    output_active: output bbool                                , /// 連続出力が有効
    output_sample: output signed logic<SAMPLE_WIDTH>           , /// 補間後の出力サンプル
    underflow    : output bbool                                , /// 入力不足のstickyフラグ
) {
    const LEVEL_WIDTH: u32 = $clog2(INPUT_DEPTH + 1);

    var fifo_empty    : logic                     ;
    var fifo_full     : logic                     ;
    var fifo_level    : logic       <LEVEL_WIDTH> ;
    var fifo_q        : signed logic<SAMPLE_WIDTH>;
    var fifo_push     : logic                     ;
    var fifo_pop      : logic                     ;
    var pop_q         : logic                     ;
    var sample0       : signed logic<SAMPLE_WIDTH>;
    var sample1       : signed logic<SAMPLE_WIDTH>;
    var window_count  : logic       <2>           ;
    var primed        : bbool                     ;
    var interpolated  : signed logic<SAMPLE_WIDTH>;
    var interpolated_q: signed logic<SAMPLE_WIDTH>;

    // 線形補間は乗算を含むためFmax確保のため3段パイプラインで計算する。
    // 丸めはgndless_interpolation::LinearInterpolatorCoreと同じresizeで行う。
    const DELTA_WIDTH    : u32                         = SAMPLE_WIDTH;
    const PHASE_EXT_WIDTH: u32                         = PHASE_WIDTH + 1;
    const PRODUCT_WIDTH  : u32                         = DELTA_WIDTH + PHASE_EXT_WIDTH;
    const NUM_WIDTH      : u32                         = PRODUCT_WIDTH + 1;
    var   delta_q        : signed logic<DELTA_WIDTH>  ;
    var   phase_q        : logic       <PHASE_WIDTH>  ;
    var   product_q      : signed logic<PRODUCT_WIDTH>;
    var   sample0_q      : signed logic<SAMPLE_WIDTH> ;
    var   sample0_qq     : signed logic<SAMPLE_WIDTH> ;

    inst input_fifo: AsrcInputFifo #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        DEPTH       : INPUT_DEPTH ,
    ) (
        clk  : clk         ,
        rst  : rst         ,
        push : fifo_push   ,
        data : input_sample,
        pop  : fifo_pop    ,
        empty: fifo_empty  ,
        full : fifo_full   ,
        level: fifo_level  ,
        q    : fifo_q      ,
    );

    always_comb {
        // 最終段: sample0(2clk前) + product(1clk前)
        let sample0_scaled: signed logic<NUM_WIDTH> = sample0_qq <<< PHASE_WIDTH;
        let numerator     : signed logic<NUM_WIDTH> = sample0_scaled + product_q;
        interpolated   = gndless_fixedpoint::resize::<
            NUM_WIDTH                         ,
            PHASE_WIDTH                       ,
            SAMPLE_WIDTH                      ,
            0                                 ,
            RoundingMode::NEAREST_TIES_TO_EVEN,
            OverflowMode::SATURATE            ,
        >(numerator);
    }

    always_comb {
        input_ready   = false;
        output_active = false;
        output_sample = 0;
        input_level   = fifo_level;

        if !fifo_full {
            input_ready = true;
        }
        if primed {
            output_active = true;
            output_sample = interpolated_q;
        }

        fifo_push = input_valid && input_ready;
        fifo_pop  = !fifo_empty && (window_count <: 2'd2 || (primed && advance));
    }

    always_ff {
        if_reset {
            sample0        = 0;
            sample1        = 0;
            window_count   = 0;
            primed         = false;
            underflow      = false;
            interpolated_q = 0;
            delta_q        = 0;
            phase_q        = 0;
            product_q      = 0;
            sample0_q      = 0;
            sample0_qq     = 0;
            pop_q          = false;
        } else {
            interpolated_q = interpolated;
            delta_q        = sample1 - sample0;
            phase_q        = phase;
            product_q      = $signed({1'b0, phase_q}) * delta_q;
            sample0_q      = sample0;
            sample0_qq     = sample0_q;
            // AsrcInputFifoの読み出しデータはpopの1クロック後に現れるため、popを1クロック
            // 登録してから窓へ取り込む。窓は位相wrapと同時に更新され、`$std::fifo`時代の
            // 1クロック遅れのスライドより位相整合が良い(実レートでは差は1/283サンプル以下)。
            pop_q = fifo_pop;
            if pop_q {
                if window_count == 2'd0 {
                    sample0      = fifo_q;
                    window_count = 2'd1;
                } else if window_count == 2'd1 {
                    sample1      = fifo_q;
                    window_count = 2'd2;
                } else {
                    sample0 = sample1;
                    sample1 = fifo_q;
                }
            }

            if !primed && window_count == 2'd2 && fifo_level >= STARTUP_LEVEL {
                primed = true;
            }
            if primed && advance && fifo_empty {
                underflow = true;
            }
        }
    }
}

/// format付きvalue interfaceを使う線形ASRC
///
/// 既定のQ4.23はmodule境界の統一formatで、±1.0の信号を±8.0の範囲で扱う
pub module LinearAsrc::<FORMAT: gndless_fixedpoint::SignedFixedPointFormat = gndless_fixedpoint::Q4_23> #(
    param PHASE_WIDTH  : u32 = 32, /// 位相入力のbit幅
    param INPUT_DEPTH  : u32 = 8 , /// 入力FIFOの深さ
    param STARTUP_LEVEL: u32 = 1 , /// 出力開始に必要な未消費FIFO word数
) (
    clk          : input   clock                                                                              ,
    rst          : input   reset                                                                              ,
    input_valid  : input   bbool                                                                              ,
    input_ready  : output  bbool                                                                              ,
    input_sample : modport gndless_fixedpoint::FixedPointValue::<FORMAT>::input_port                          ,
    input_level  : output  logic                                                     <$clog2(INPUT_DEPTH + 1)>,
    phase        : input   logic                                                     <PHASE_WIDTH>            ,
    advance      : input   bbool                                                                              ,
    output_active: output  bbool                                                                              ,
    output_sample: modport gndless_fixedpoint::FixedPointValue::<FORMAT>::output_port                         ,
    underflow    : output  bbool                                                                              ,
) {
    inst core: LinearAsrcCore #(
        SAMPLE_WIDTH : FORMAT::WIDTH,
        PHASE_WIDTH  : PHASE_WIDTH  ,
        INPUT_DEPTH  : INPUT_DEPTH  ,
        STARTUP_LEVEL: STARTUP_LEVEL,
    ) (
        clk                             ,
        rst                             ,
        input_valid                     ,
        input_ready                     ,
        input_sample : input_sample.raw ,
        input_level                     ,
        phase                           ,
        advance                         ,
        output_active                   ,
        output_sample: output_sample.raw,
        underflow                       ,
    );
}

/// 線形ASRCと分数位相アキュムレータの最小統合を検証
#[test(test_linear_asrc)]
module test_linear_asrc {
    const SAMPLE_WIDTH: u32 = 16;
    const PHASE_WIDTH : u32 = 4;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid  : bbool           ;
    var input_ready  : bbool           ;
    var input_sample : signed logic<16>;
    var input_level  : logic       <4> ;
    var phase        : logic       <4> ;
    var advance      : bbool           ;
    var output_active: bbool           ;
    var output_sample: signed logic<16>;
    var underflow    : bbool           ;
    var phase_enable : bbool           ;
    var phase_inc    : logic       <4> ;

    inst phase_accumulator: gndless_nco::FractionalPhaseAccumulator #(
        WIDTH: PHASE_WIDTH,
    ) (
        clk                          ,
        rst                          ,
        enable         : phase_enable,
        phase_increment: phase_inc   ,
        phase                        ,
        advance                      ,
    );

    inst asrc: LinearAsrcCore #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
        INPUT_DEPTH : 8           ,
    ) (
        clk            ,
        rst            ,
        input_valid    ,
        input_ready    ,
        input_sample   ,
        input_level    ,
        phase          ,
        advance        ,
        output_active  ,
        output_sample  ,
        underflow      ,
    );

    initial {
        input_valid  = false;
        input_sample = 0;
        phase_enable = true;
        phase_inc    = 4'd4;
        rst.assert();

        // 0, 100, 200, 300を連続投入し、窓を初期化する
        input_valid  = true;
        input_sample = 16'sd0;
        clk.next(1);
        input_sample = 16'sd100;
        clk.next(1);
        input_sample = 16'sd200;
        clk.next(1);
        input_sample = 16'sd300;
        clk.next(1);
        input_valid = false;

        // AsrcInputFifo(BSRAM)化により窓更新が1クロック遅れ、位相wrapと同時に窓が切り替わる。
        // 出力は1クロック遅れで現れる(実レートでは位相刻み1/283以下で無視できる差)。
        clk.next(1);
        $assert(output_active, "linear ASRC must become active after priming");
        $assert(output_sample == 16'sd0, "linear ASRC must hold the initial window while priming");
        $assert(!underflow, "linear ASRC must not underflow with buffered input");
        $assert(input_level == 4'd1, "priming sample must remain in the FIFO");

        clk.next(2);
        $assert(output_sample == 16'sd25, "linear ASRC quarter phase mismatch");
        clk.next(1);
        $assert(output_sample == 16'sd150, "linear ASRC second window half phase mismatch");
        clk.next(1);
        $assert(output_sample == 16'sd175, "linear ASRC second window three-quarter phase mismatch");
        clk.next(1);
        $assert(output_sample == 16'sd100, "linear ASRC phase wrap must reset to the new window");
        clk.next(1);
        $assert(output_sample == 16'sd125, "linear ASRC second window quarter phase mismatch");
        $assert(!underflow, "linear ASRC must keep the buffered stream running");
        $finish();
    }
}
